<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitStatusWidget.Desktop.ViewModels"
        x:Class="GitStatusWidget.Desktop.Views.UpdateWindow"
        x:DataType="vm:UpdateViewModel"
        Title="GitWidget – Update"
        Width="500"
        SizeToContent="Height"
        CanResize="False"
        Icon="/Assets/gitwidget.png"
        Background="{DynamicResource PageBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
  <!-- Update dialog (issue #19): install the new release in place, or open its release page. -->
  <StackPanel Margin="18,16,18,16" Spacing="10">
    <StackPanel Spacing="2">
      <TextBlock Classes="section" Text="{Binding Title}" Margin="0" TextWrapping="Wrap" />
      <TextBlock Classes="subtle" Text="{Binding CurrentText}" />
    </StackPanel>

    <TextBlock TextWrapping="Wrap" IsVisible="{Binding CanInstall}"
               Text="GitWidget downloads the release, checks it against the checksum published with it, replaces its files and restarts. The previous version is kept until the new one has started." />
    <TextBlock x:Name="CannotInstallText" Classes="subtle" TextWrapping="Wrap" Text="{Binding CannotInstallReason}" IsVisible="{Binding HasCannotInstallReason}" />

    <ProgressBar x:Name="DownloadProgress" Classes="usage large" Minimum="0" Maximum="100" Value="{Binding Progress}"
                 IsIndeterminate="{Binding IsIndeterminate}" IsVisible="{Binding IsBusy}" />
    <TextBlock x:Name="StatusLine" TextWrapping="Wrap" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" Classes.problem="{Binding IsFailed}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="Open release page" Command="{Binding OpenReleasePageCommand}" IsVisible="{Binding IsAvailable}" />
      <Button Content="Cancel download" Command="{Binding CancelInstallCommand}" IsVisible="{Binding CanCancel}" />
      <Button x:Name="InstallButton" Classes="accent" Content="{Binding InstallText}" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
      <Button Content="Close" Command="{Binding CloseCommand}" IsEnabled="{Binding !IsBusy}" />
    </StackPanel>
  </StackPanel>
</Window>
