<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitStatusWidget.Desktop.ViewModels"
             x:Class="GitStatusWidget.Desktop.App"
             x:DataType="vm:TrayViewModel"
             Name="GitWidget"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://GitWidget/Themes/Theme.axaml" />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <!-- FallbackValue is required: a null tooltip crashes the macOS tray at startup. -->
      <TrayIcon Icon="{Binding Icon}" ToolTipText="{Binding ToolTip, FallbackValue=GitWidget}" Command="{Binding ShowWidgetCommand}">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Show widget" Command="{Binding ShowWidgetCommand}" />
            <NativeMenuItem Header="Open dashboard" Command="{Binding OpenDashboardCommand}" CommandParameter="{x:Null}" />
            <NativeMenuItem Header="Refresh now" Command="{Binding RefreshCommand}" />
            <NativeMenuItem Header="{Binding UpdateMenuText}" IsVisible="{Binding UpdateAvailable}" Command="{Binding OpenUpdateCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Repositories">
              <NativeMenu />
            </NativeMenuItem>
            <NativeMenuItem Header="Always on top" ToggleType="CheckBox" IsChecked="{Binding AlwaysOnTop}" Command="{Binding ToggleAlwaysOnTopCommand}" />
            <NativeMenuItem Header="Start at login" ToggleType="CheckBox" IsChecked="{Binding StartAtLogin}" IsEnabled="{Binding StartAtLoginSupported}" Command="{Binding ToggleStartAtLoginCommand}" />
            <NativeMenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" />
            <NativeMenuItem Header="Diagnostics…" Command="{Binding OpenDiagnosticsCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit" Command="{Binding ExitCommand}" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
