<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia desktop shell: tray, widget, dashboard, toasts, settings. Composition root. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GitWidget</AssemblyName>
    <RootNamespace>GitStatusWidget.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gitwidget.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Executable without public API surface: XML docs are not required for UI code. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GitStatusWidget.Domain\GitStatusWidget.Domain.csproj" />
    <ProjectReference Include="..\GitStatusWidget.Application\GitStatusWidget.Application.csproj" />
    <ProjectReference Include="..\GitStatusWidget.Infrastructure\GitStatusWidget.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GitStatusWidget.Desktop.Tests" />
  </ItemGroup>
</Project>
